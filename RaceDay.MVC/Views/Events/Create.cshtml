@model RaceDay.MVC.Models.EventViewModel

@{
    ViewData["Title"] = "Create Event";
}

<div class="container mt-4">
    <h2>Create a RaceDay Event</h2>
    <p class="text-muted">Enter the details of the new event below.</p>

    <form asp-action="Create"
          method="post"
          enctype="multipart/form-data">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="All"
             class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="EventName" class="form-label">
                Event Name
            </label>
            <input asp-for="EventName"
                   class="form-control"
                   placeholder="Enter event name" />
            <span asp-validation-for="EventName"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="EventTypeID" class="form-label">
                Event Type
            </label>
            <select asp-for="EventTypeID"
                    asp-items="ViewBag.EventTypes"
                    class="form-select">
                <option value="">-- Select Event Type --</option>
            </select>
            <span asp-validation-for="EventTypeID"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label">
                Description
            </label>
            <textarea asp-for="Description"
                      class="form-control"
                      rows="4"
                      placeholder="Describe the event"></textarea>
            <span asp-validation-for="Description"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="EventDate" class="form-label">
                Event Date and Time
            </label>
            <input asp-for="EventDate"
                   type="datetime-local"
                   class="form-control" />
            <span asp-validation-for="EventDate"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Location" class="form-label">
                Location
            </label>
            <input asp-for="Location"
                   class="form-control"
                   placeholder="Enter event location" />
            <span asp-validation-for="Location"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Distance" class="form-label">
                Distance (km)
            </label>
            <input asp-for="Distance"
                   type="number"
                   step="0.01"
                   class="form-control"
                   placeholder="e.g. 10" />
            <span asp-validation-for="Distance"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label">
                Event Banner Image (Optional)
            </label>

            <input type="file"
                   name="banner"
                   class="form-control"
                   accept=".jpg,.jpeg,.png,.gif,.webp" />

            <small class="text-muted">
                Accepted formats: JPG, PNG, GIF and WEBP.
                Maximum size: 5 MB.
            </small>
        </div>

        <button type="submit" class="btn btn-primary">
            Create Event
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            Cancel
        </a>

    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
