@model RaceDay.MVC.Models.EventViewModel

@{
    ViewData["Title"] = "Delete Event";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-7">

            <div class="card shadow">
                <div class="card-header bg-danger text-white">
                    <h3 class="mb-0">Delete Event</h3>
                </div>

                <div class="card-body">

                    <div class="alert alert-warning">
                        <strong>Warning!</strong>
                        Are you sure you want to delete this event?
                        This action cannot be undone.
                    </div>

                    <h4>@Model.EventName</h4>

                    <hr />

                    <dl class="row">
                        <dt class="col-sm-4">Event Date</dt>
                        <dd class="col-sm-8">
                            @Model.EventDate.ToString("dd MMMM yyyy HH:mm")
                        </dd>

                        <dt class="col-sm-4">Location</dt>
                        <dd class="col-sm-8">@Model.Location</dd>

                        <dt class="col-sm-4">Distance</dt>
                        <dd class="col-sm-8">@Model.Distance km</dd>
                    </dl>

                    <form asp-controller="Events"
                          asp-action="Delete"
                          asp-route-id="@Model.EventID"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div class="d-flex gap-2 mt-4">

                            <button type="submit"
                                    class="btn btn-danger">
                                Yes, Delete Event
                            </button>

                            <a asp-controller="Events"
                               asp-action="Index"
                               class="btn btn-secondary">
                                Cancel
                            </a>

                        </div>
                    </form>

                </div>
            </div>

        </div>
    </div>
</div>
