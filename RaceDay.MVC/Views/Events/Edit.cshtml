@model RaceDay.MVC.Models.EventViewModel

@{
    ViewData["Title"] = "Edit Event";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">

            <div class="card shadow">
                <div class="card-header bg-dark text-white">
                    <h3 class="mb-0">Edit RaceDay Event</h3>
                </div>

                <div class="card-body">

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3"></div>

                    <form asp-controller="Events"
                          asp-action="Edit"
                          asp-route-id="@Model.EventID"
                          method="post"
                          enctype="multipart/form-data">

                        @Html.AntiForgeryToken()

                        <input type="hidden" asp-for="EventID" />
                        <input type="hidden" asp-for="OrganiserID" />
                        <input type="hidden" asp-for="CreatedDate" />
                        <input type="hidden" asp-for="BannerImageURL" />

                        <div class="mb-3">
                            <label asp-for="EventName" class="form-label">
                                Event Name
                            </label>
                            <input asp-for="EventName" class="form-control" />
                            <span asp-validation-for="EventName"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label">
                                Description
                            </label>
                            <textarea asp-for="Description"
                                      class="form-control"
                                      rows="4"></textarea>
                            <span asp-validation-for="Description"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="EventTypeID" class="form-label">
                                Event Type
                            </label>
                            <select asp-for="EventTypeID"
                                    asp-items="ViewBag.EventTypes"
                                    class="form-select">
                                <option value="">-- Select Event Type --</option>
                            </select>
                            <span asp-validation-for="EventTypeID"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="EventDate" class="form-label">
                                Event Date
                            </label>
                            <input asp-for="EventDate"
                                   type="datetime-local"
                                   class="form-control" />
                            <span asp-validation-for="EventDate"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Location" class="form-label">
                                Location
                            </label>
                            <input asp-for="Location" class="form-control" />
                            <span asp-validation-for="Location"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Distance" class="form-label">
                                Distance (km)
                            </label>
                            <input asp-for="Distance"
                                   type="number"
                                   step="0.01"
                                   class="form-control" />
                            <span asp-validation-for="Distance"
                                  class="text-danger"></span>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(Model.BannerImageURL))
                        {
                            <div class="mb-3">
                                <label class="form-label">
                                    Current Event Banner
                                </label>
                                <div>
                                    <img src="@Model.BannerImageURL"
                                         alt="Current event banner"
                                         class="img-fluid rounded"
                                         style="max-height:200px;" />
                                </div>
                            </div>
                        }

                        <div class="mb-4">
                            <label class="form-label">
                                Replace Event Banner (Optional)
                            </label>

                            <input type="file"
                                   name="banner"
                                   class="form-control"
                                   accept=".jpg,.jpeg,.png,.gif,.webp" />

                            <small class="text-muted">
                                JPG, PNG, GIF or WEBP. Maximum 5 MB.
                                Leave empty to keep the current banner.
                            </small>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-success">
                                Save Changes
                            </button>

                            <a asp-controller="Events"
                               asp-action="Index"
                               class="btn btn-secondary">
                                Cancel
                            </a>
                        </div>

                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
