@model IEnumerable<RaceDay.MVC.Models.EventViewModel>

@{
    ViewData["Title"] = "RaceDay Events";
    var role = Context.Session.GetString("Role");
    var userID = Context.Session.GetInt32("UserID");
}

<div class="container mt-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>RaceDay Events</h1>
            <p class="text-muted">
                Discover upcoming races and sporting events.
            </p>
        </div>

        @if (role == "Organiser")
        {
            <a asp-controller="Events"
               asp-action="Create"
               class="btn btn-success">
                Create Event
            </a>
        }
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No events are currently available.
        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var item in Model)
            {
                <div class="col-md-4">

                    <div class="card shadow-sm h-100">

                        @if (!string.IsNullOrWhiteSpace(item.BannerImageURL))
                        {
                            <img src="@item.BannerImageURL"
                                 class="card-img-top"
                                 alt="@item.EventName banner"
                                 style="height:200px; object-fit:cover;" />
                        }
                        else
                        {
                            <div class="bg-light d-flex align-items-center justify-content-center"
                                 style="height:200px;">
                                <span class="text-muted">
                                    RaceDay Event
                                </span>
                            </div>
                        }

                        <div class="card-body d-flex flex-column">

                            <h5 class="card-title">
                                @item.EventName
                            </h5>

                            <p class="card-text">
                                @item.Description
                            </p>

                            <p>
                                <strong>Date:</strong>
                                @item.EventDate.ToString("dd MMMM yyyy")
                            </p>

                            <p>
                                <strong>Location:</strong>
                                @item.Location
                            </p>

                            <p>
                                <strong>Distance:</strong>
                                @item.Distance km
                            </p>

                            <div class="mt-auto d-flex flex-wrap gap-2">

                                <a asp-controller="Events"
                                   asp-action="Details"
                                   asp-route-id="@item.EventID"
                                   class="btn btn-primary">
                                    View Details
                                </a>

                                @if (role == "Organiser" &&
                                                        userID == item.OrganiserID)
                                {
                                    <a asp-controller="Events"
                                       asp-action="Edit"
                                       asp-route-id="@item.EventID"
                                       class="btn btn-warning">
                                        Edit
                                    </a>

                                    <a asp-controller="Events"
                                       asp-action="Delete"
                                       asp-route-id="@item.EventID"
                                       class="btn btn-danger">
                                        Delete
                                    </a>
                                }

                            </div>

                        </div>
                    </div>

                </div>
            }

        </div>
    }

</div>
