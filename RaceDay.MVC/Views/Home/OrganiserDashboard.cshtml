@{
    ViewData["Title"] = "Organiser Dashboard";
}

<div class="container mt-5">

    <div class="mb-4">
        <h1>Welcome, @Context.Session.GetString("FirstName")!</h1>
        <p class="text-muted">
            RaceDay Organiser Dashboard
        </p>
    </div>

    <div class="row g-4">

        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title">Manage Events</h5>
                    <p class="card-text">
                        Create, update and manage RaceDay events.
                    </p>
                    <a asp-controller="Events"
                       asp-action="Index"
                       class="btn btn-primary">
                        Manage Events
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title">Manage Enrolments</h5>
                    <p class="card-text">
                        View participants enrolled in your events.
                    </p>
                    <a asp-controller="OrganiserEnrolments"
                       asp-action="Index"
                       class="btn btn-primary">
                        View Enrolments
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title">Capture Results</h5>
                    <p class="card-text">
                        Capture and publish participant finishing times and positions.
                    </p>
                    <a asp-controller="Results"
                       asp-action="Index"
                       class="btn btn-primary">
                        Manage Results
                    </a>
                  
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title">Manage Categories</h5>
                    <p class="card-text">
                        Manage race categories available for participant enrolment.
                    </p>
                    <a asp-controller="Categories"
                       asp-action="Index"
                       class="btn btn-primary">
                        Manage Categories
                    </a>
                </div>
            </div>
        </div>

    </div>
</div>
