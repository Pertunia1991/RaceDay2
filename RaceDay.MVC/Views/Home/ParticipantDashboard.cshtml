@{
    ViewData["Title"] = "Participant Dashboard";
}

<div class="container mt-5">

    <div class="mb-4">
        <h1>Welcome, @Context.Session.GetString("FirstName")!</h1>

        <p class="text-muted">
            RaceDay Participant Dashboard
        </p>
    </div>

    <div class="row g-4">

        <!-- VIEW EVENTS -->
        <div class="col-lg-3 col-md-6">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title">View Events</h5>
                    <p class="card-text">
                        Explore upcoming RaceDay events and view event details.
                    </p>
                    <a asp-controller="Events"
                       asp-action="Index"
                       class="btn btn-primary">
                        Browse Events
                    </a>
                </div>
            </div>
        </div>

        <!-- MY ENROLMENTS -->
        <div class="col-lg-3 col-md-6">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title">My Enrolments</h5>
                    <p class="card-text">
                        View the events you have enrolled in and check your enrolment status.
                    </p>
                    <a asp-controller="Enrolments"
                       asp-action="Index"
                       class="btn btn-primary">
                        View My Enrolments
                    </a>
                </div>
            </div>
        </div>

        <!-- MY RESULTS -->
        <div class="col-lg-3 col-md-6">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title">My Results</h5>
                    <p class="card-text">
                        View your published race results, finishing times and positions.
                    </p>
                    <a asp-controller="Results"
                       asp-action="MyResults"
                       class="btn btn-primary">
                        View Results
                    </a>
                </div>
            </div>
        </div>

        <!-- MY PROFILE -->
        <div class="col-lg-3 col-md-6">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title">My Profile</h5>
                    <p class="card-text">
                        View and update your personal information.
                    </p>
                    <a asp-controller="Profile"
                       asp-action="Index"
                       class="btn btn-success">
                        Manage Profile
                    </a>
                </div>
            </div>
        </div>

    </div>

</div>
